{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cert-observation/v1/schema.json",
  "title": "Certificate Observation Record Set (version 1)",
  "description": "JSON Schema equivalent of schema/cert-observation.cddl. The CDDL in the draft is normative; this schema is a convenience for tooling.",
  "type": "object",
  "required": ["version", "records"],
  "properties": {
    "version": { "const": 1 },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "record": {
      "type": "object",
      "required": ["version", "reporter", "subject", "location", "evidence", "observed-at"],
      "properties": {
        "version": { "const": 1 },
        "record-id": { "type": "string" },
        "reporter": { "type": "string", "minLength": 1 },
        "subject": { "$ref": "#/$defs/subject" },
        "location": { "$ref": "#/$defs/location" },
        "evidence": {
          "type": "string",
          "description": "Registered values: issued, declared, deployed, observed-store, observed-wire"
        },
        "observed-at": { "$ref": "#/$defs/timestamp" },
        "valid-for": { "type": "integer", "minimum": 0 },
        "certificate": { "$ref": "#/$defs/certificate" },
        "chain": { "$ref": "#/$defs/chain" },
        "expected-sha256": { "$ref": "#/$defs/fingerprint" },
        "renewal-window": {
          "type": "object",
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "#/$defs/timestamp" },
            "end": { "$ref": "#/$defs/timestamp" }
          },
          "additionalProperties": false
        },
        "status": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "extensions": { "type": "object" }
      },
      "additionalProperties": false,
      "if": {
        "not": {
          "required": ["status"],
          "properties": { "status": { "contains": { "const": "not-found" } } }
        }
      },
      "then": { "required": ["certificate"] }
    },
    "subject": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "service": { "type": "string" },
        "id": { "type": "string" }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "properties": {
        "address": { "type": "string" },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "sni": { "type": "string" },
        "path": { "type": "string" },
        "store": { "type": "string" },
        "label": { "type": "string" },
        "config-item": { "type": "string" }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "certificate": {
      "type": "object",
      "required": ["sha256", "not-after"],
      "properties": {
        "sha256": { "$ref": "#/$defs/fingerprint" },
        "subject-dn": { "type": "string" },
        "san": { "type": "array", "items": { "type": "string" } },
        "issuer-dn": { "type": "string" },
        "serial": { "type": "string" },
        "not-before": { "$ref": "#/$defs/timestamp" },
        "not-after": { "$ref": "#/$defs/timestamp" },
        "public-key-algorithm": { "type": "string" },
        "public-key-size": { "type": "integer", "minimum": 0 },
        "signature-algorithm": { "type": "string" },
        "der": { "type": "string", "contentEncoding": "base64" }
      },
      "additionalProperties": false
    },
    "chain": {
      "type": "object",
      "required": ["validation"],
      "properties": {
        "certificates": { "type": "array", "items": { "$ref": "#/$defs/fingerprint" } },
        "validation": { "enum": ["valid", "invalid", "incomplete", "not-checked"] },
        "trust-anchor": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
